```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
dist/
build/
target/

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
*.env.*

# Logs and temp files
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/

# System files
.DS_Store
Thumbs.db

# Coverage
.coverage
coverage/
htmlcov/

# Python specific
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
*.so
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
*.egg-info/
.eggs/

# Node.js specific
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
node_modules/
dist/
build/
.nyc_output/
coverage/
*.lcov

# TypeScript/JavaScript build output
*.js.map
*.tsbuildinfo
lib/
out/
dist/
build/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
```